theme = Nordfox
font-size = 22
font-family = Comic Code

# No ligatures
font-feature = -calt, -liga, -dlig

# Titlebar/Tabs
macos-titlebar-style = tabs
macos-window-buttons = hidden

# Set the cursor to a block
shell-integration-features = no-cursor
cursor-style = block
cursor-style-blink = false

# This makes the padding even between the 4 sides
window-padding-balance = true
window-padding-x = 0
window-padding-y = 0

# Misc
mouse-hide-while-typing = true
quit-after-last-window-closed = true
bell-features = system

# Keybinds
# In defaults, these were scroll to selection and clear screen respectively
keybind = cmd+j=scroll_page_lines:1
keybind = cmd+k=scroll_page_lines:-1

# Mimics jumping by half a page in nvim
keybind = cmd+d=scroll_page_fractional:0.5
keybind = cmd+u=scroll_page_fractional:-0.5

# Splits
keybind = cmd+s=new_split:right
# Hyper key from Raycast
keybind = shift+ctrl+opt+cmd+l=goto_split:right
keybind = shift+ctrl+opt+cmd+h=goto_split:left

# Tabs
keybind = cmd+l=next_tab
keybind = cmd+h=previous_tab
keybind = cmd+r=prompt_tab_title

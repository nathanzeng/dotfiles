theme = Nordfox
font-size = 20

# No ligatures
font-feature = -calt, -liga, -dlig

# Titlebar/Tabs
macos-titlebar-style = tabs
macos-window-buttons = hidden

# Set the cursor to a block
shell-integration-features = no-cursor
cursor-style = block
cursor-style-blink = false

# This makes the padding even between the 4 sides
window-padding-balance = true
window-padding-x = 0
window-padding-y = 0

# Misc
mouse-hide-while-typing = true
quit-after-last-window-closed = true
bell-features = system

# Keybinds
# In defaults, these were scroll to selection and clear screen respectively
keybind = super+j=scroll_page_lines:1
keybind = super+k=scroll_page_lines:-1

# Mimics jumping by half a page in nvim
keybind = super+d=scroll_page_fractional:0.5
keybind = super+u=scroll_page_fractional:-0.5

# This was super+d by default
keybind = super+s=new_split:right
